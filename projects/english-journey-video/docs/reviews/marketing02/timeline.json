  "segments": [
    {
      "id": "hook",
      "label": "HOOK",
      "spoken": "Học 10 từ tiếng Anh hôm nay… vài ngày sau quên gần hết? Bạn có đang như vậy không?",
      "startMs": 0.0,
      "endMs": 6333.333333333333
    },
    {
      "id": "problem",
      "label": "PROBLEM",
      "spoken": "Bạn học nghĩa của từ, ghi vào vở, đọc lại vài lần. Nhưng đến khi cần đặt câu, bạn lại chẳng biết dùng từ đó như thế nào.",
      "startMs": 6333.333333333333,
      "endMs": 16833.333333333332
    },
    {
      "id": "solution",
      "label": "SOLUTION",
      "spoken": "Vậy thử đổi cách học xem! Thay vì chỉ nhờ ChatGPT giải nghĩa, mình dùng AI để luyện cách sử dụng từ vựng ngay trong câu.",
      "startMs": 16833.333333333332,
      "endMs": 27266.666666666664
    },
    {
      "id": "demo",
      "label": "DEMO",
      "spoken": "Ví dụ với từ improve, nghĩa là cải thiện. AI không chỉ giải thích, mà còn yêu cầu mình tự đặt câu. Mình viết: I want to improve my English. Sau đó, AI kiểm tra và giúp mình sửa nếu có lỗi.",
      "startMs": 27266.666666666664,
      "endMs": 44000.0
    },
    {
      "id": "benefit",
      "label": "BENEFIT",
      "spoken": "Những từ chưa nhớ, mình lưu lại để buổi sau nhờ AI kiểm tra tiếp. Như vậy, mình biết cần ôn từ nào thay vì cứ học thêm từ mới.",
      "startMs": 44000.0,
      "endMs": 54600.0
    },
    {
      "id": "cta",
      "label": "CTA",
      "spoken": "Muốn biết cách mình thiết lập ChatGPT để học như vậy? Bình luận BẮT ĐẦU, mình chia sẻ cách làm nhé!",
      "startMs": 54600.0,
      "endMs": 62533.33333333333
    }
  ],
