{
  "name": "english-journey-video",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "node scripts/render.mjs",
    "proofs": "node scripts/proofs.mjs",
    "qa": "node scripts/qa.mjs",
    "typecheck": "tsc --noEmit",
    "tts": "python3 scripts/voiceover/build.py",
    "render:voice": "node scripts/render.mjs --voice",
    "proofs:voice": "node scripts/proofs.mjs --voice",
    "qa:voice": "node scripts/qa-voice.mjs",
    "test:voice": "node --test scripts/voiceover/timing.test.mjs",
    "build:v2": "python3 scripts/v2/build.py",
    "proofs:v2": "node scripts/v2/render.mjs --proofs",
    "render:v2": "node scripts/v2/render.mjs",
    "qa:v2": "python3 scripts/v2/qa.py",
    "build:marketing": "python3 scripts/marketing/build.py",
    "proofs:marketing": "node scripts/marketing/render.mjs --proofs",
    "render:marketing": "node scripts/marketing/render.mjs",
    "qa:marketing": "python3 scripts/marketing/qa.py",
    "review:prepare": "node scripts/review/prepare.mjs",
    "review:compare": "node scripts/review/compare.mjs",
    "test:review": "node --test scripts/review/*.test.mjs",
    "build:marketing02": "python3 scripts/marketing02/build.py",
    "proofs:marketing02": "node scripts/marketing02/render.mjs --proofs",
    "render:marketing02": "node scripts/marketing02/render.mjs",
    "qa:marketing02": "PYTHONPATH=. python3 scripts/marketing02/qa.py",
    "azure:marketing02:estimate": "node scripts/marketing02/azure-namminh-auditions.mjs",
    "azure:marketing02:samples": "node scripts/marketing02/azure-namminh-auditions.mjs --execute --confirm-standard-s0",
    "test:azure:marketing02": "node --test scripts/marketing02/azure-namminh-auditions.test.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
