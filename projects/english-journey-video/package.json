    "test:marketing03:pipeline": "node --test scripts/marketing03/direct-audio.test.mjs",
    "check:marketing03:audio": "node scripts/marketing03/local-smoke.mjs",
    "setup:marketing03:browser": "node scripts/marketing03/setup-browser.mjs",
