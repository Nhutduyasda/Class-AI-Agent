{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "productionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "ENGLISH_LEARNING",
        "PRODUCT_SHOWCASE"
      ]
    },
    "trigger": {
      "type": "string",
      "enum": [
        "SCHEDULED",
        "ON_DEMAND"
      ]
    },
    "scheduledFor": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "localDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "codeSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "requests": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "provider": {
            "type": "string",
            "enum": [
              "MOCK_LLM",
              "MOCK_AZURE_SPEECH",
              "REAL_PROVIDER_DISABLED"
            ]
          },
          "maxMicrousd": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "inputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "requestId",
          "provider",
          "maxMicrousd",
          "inputSha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "productionId",
    "mode",
    "trigger",
    "scheduledFor",
    "localDate",
    "contentSha256",
    "policySha256",
    "codeSha",
    "requests"
  ],
  "additionalProperties": false
}
