{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "audio": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.(wav|png|jpg|mp4)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "durationSamples": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "observedDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provenance": {
          "type": "string",
          "enum": [
            "SYNTHETIC_OFFLINE",
            "AUTHORIZED_LOCAL"
          ]
        },
        "alignment": {
          "type": "string",
          "const": "UNVERIFIED"
        }
      },
      "required": [
        "file",
        "sha256",
        "sampleRate",
        "durationSamples",
        "observedDurationSeconds",
        "provenance",
        "alignment"
      ],
      "additionalProperties": false
    },
    "captions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endFrame": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sceneId",
          "text",
          "startFrame",
          "endFrame"
        ],
        "additionalProperties": false
      }
    },
    "presenterAssets": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "presenterId": {
            "type": "string",
            "const": "minh-main"
          },
          "file": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+\\.(wav|png|jpg|mp4)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fileType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "video/mp4"
            ]
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rightsBasis": {
            "type": "string",
            "enum": [
              "OWNER_PROVIDED_PERMISSION",
              "ORIGINAL_OFFLINE_FIXTURE",
              "LICENSED"
            ]
          },
          "usageRestrictions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceReference": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "string",
            "enum": [
              "HANDS_ONLY",
              "FACE_ONLY",
              "HALF_BODY",
              "FULL_BODY"
            ]
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "APPROVED_OFFLINE_ONLY"
            ]
          },
          "identityVerified": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "assetId",
          "presenterId",
          "file",
          "sha256",
          "fileType",
          "width",
          "height",
          "rightsBasis",
          "usageRestrictions",
          "sourceReference",
          "visibility",
          "reviewStatus",
          "identityVerified"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "captions",
    "presenterAssets"
  ],
  "additionalProperties": false
}
