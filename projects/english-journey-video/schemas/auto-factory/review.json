{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "videoSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "const": "PENDING_OWNER"
    },
    "fixture": {
      "type": "boolean",
      "const": true
    },
    "publicationAllowed": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "planSha256",
    "videoSha256",
    "status",
    "fixture",
    "publicationAllowed"
  ],
  "additionalProperties": false
}
